# Supabase 프로젝트 설정
# EXPO_PUBLIC_ 접두사 → 앱 번들에 포함됨 (클라이언트에서 접근 가능)
# Supabase 대시보드 > Settings > API 에서 확인
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyXXXXXXXXXXXXXXXXXXXX

# 개발용 API 서버 주소
# iOS 시뮬레이터에서는 localhost 대신 127.0.0.1 사용
# 안드로이드 에뮬레이터에서는 10.0.2.2 사용
EXPO_PUBLIC_API_URL=http://localhost:3000/api
