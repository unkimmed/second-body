{
  "name": "second-body",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "mobile": "pnpm --filter mobile start",
    "mobile:ios": "pnpm --filter mobile ios",
    "mobile:android": "pnpm --filter mobile android",
    "mobile:web": "pnpm --filter mobile web",
    "api": "pnpm --filter api start:dev",
    "api:build": "pnpm --filter api build",
    "shared:build": "pnpm --filter @second-body/shared build"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "pnpm": {
    "packageExtensions": {
      "expo-router": {
        "peerDependencies": {
          "react-dom": "*",
          "escape-string-regexp": "*"
        }
      }
    }
  }
}
